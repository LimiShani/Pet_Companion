{
  "@@locale": "en",
  "title": "Today",
  "@title": {
    "description": "The title of Home's Today card."
  },
  "headerDone": "{day} · {done} of {total} done",
  "@headerDone": {
    "description": "The line beside the Today title: the date, and how many of the day's items are done.",
    "placeholders": {
      "day": {
        "type": "String"
      },
      "done": {
        "type": "int"
      },
      "total": {
        "type": "int"
      }
    }
  },
  "withPet": "{title} · {pet}",
  "@withPet": {
    "description": "A row's title with its pet's name, when the account has more than one pet: \"Breakfast · Kelly\".",
    "placeholders": {
      "title": {
        "type": "String"
      },
      "pet": {
        "type": "String"
      }
    }
  },
  "you": "you",
  "@you": {
    "description": "Who logged a done row when it was the signed-in person: \"7:40 · you\"."
  },
  "doneBy": "{time} · {who}",
  "@doneBy": {
    "description": "Under a done row: when it was done and who did it (a household member's name, or \"you\").",
    "placeholders": {
      "time": {
        "type": "String"
      },
      "who": {
        "type": "String"
      }
    }
  },
  "notDoneBy": "{time} · {who} · not done",
  "@notDoneBy": {
    "description": "Under a row answered as not done (a meal not eaten, a dose not given).",
    "placeholders": {
      "time": {
        "type": "String"
      },
      "who": {
        "type": "String"
      }
    }
  },
  "notDoneAt": "{time} · not done",
  "@notDoneAt": {
    "description": "Under a row answered as not done when who answered is not known.",
    "placeholders": {
      "time": {
        "type": "String"
      }
    }
  },
  "runsOutIn": "{count, plural, =0{{name} runs out today} =1{{name} runs out tomorrow} other{{name} runs out in {count} days}}",
